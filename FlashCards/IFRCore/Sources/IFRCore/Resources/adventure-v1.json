  "dialogue": {
    "hypoxia-intro": {
      "pages": [
        "Fly in the clouds? Prove you can think up there.",
        "Above 12,500 feet your brain lacks oxygen. Has yours?"
      ]
    },
    "hypoxia-win": {
      "pages": [
        "Your consciousness held up. Take the OXYGEN BADGE."
      ]
    },
    "hypoxia-lose": {
      "pages": [
        "Cyanosis and poor judgment. Breathe and return."
      ]
    },
    "gyro-intro": {
      "pages": [
        "Spin, precess, tumble. My gauges never lie. Do yours?",
        "Trust your instruments over your inner ear."
      ]
    },
    "gyro-win": {
      "pages": [
        "Attitude, heading, turn. Take the GYRO BADGE."
      ]
    },
    "gyro-lose": {
      "pages": [
        "Your vacuum pump failed. Partial panel, pilot."
      ]
    },
    "reg-intro": {
      "pages": [
        "Know the rules before you fly. Recite them.",
        "One violation is one too many. Fly by the book."
      ]
    },
    "reg-win": {
      "pages": [
        "Clean logbook, clean checkride. Take the badge."
      ]
    },
    "reg-lose": {
      "pages": [
        "That is a violation waiting to happen. Study the FARs."
      ]
    },
    "victor-intro": {
      "pages": [
        "Find your way from VOR to VOR, pilot. No shortcuts.",
        "A wrong heading burns fuel and burns time."
      ]
    },
    "victor-win": {
      "pages": [
        "Right on course. Take the NAVIGATION BADGE."
      ]
    },
    "victor-lose": {
      "pages": [
        "You are off the airway. Recompute and try again."
      ]
    },
    "plotter-intro": {
      "pages": [
        "A good plan beats a good save every time.",
        "Weight, balance, fuel, alternates. All checked?"
      ]
    },
    "plotter-win": {
      "pages": [
        "Fuel, weight, alternates checked. Take the badge."
      ]
    },
    "plotter-lose": {
      "pages": [
        "That flight plan never leaves the ground."
      ]
    },
    "nimbus-intro": {
      "pages": [
        "Read the sky before it reads you.",
        "A front waits for no pilot. Watch the trends."
      ]
    },
    "nimbus-win": {
      "pages": [
        "You saw the front coming. Take the WEATHER BADGE."
      ]
    },
    "nimbus-lose": {
      "pages": [
        "That cell was closer than you thought."
      ]
    },
    "mayday-intro": {
      "pages": [
        "Engine out, lost comm, fire aboard. Stay calm and fly.",
        "Checklist first, radio second, panic never."
      ]
    },
    "mayday-win": {
      "pages": [
        "Textbook emergency handling. Take the EMERGENCY BADGE."
      ]
    },
    "mayday-lose": {
      "pages": [
        "You froze at the worst moment. Drill it again."
      ]
    },
    "ilsa-intro": {
      "pages": [
        "Needles alive at minimums. Fly a stable approach.",
        "Missed approach point passed? Go around, now."
      ]
    },
    "ilsa-win": {
      "pages": [
        "Right down the centerline. Take the APPROACH BADGE."
      ]
    },
    "ilsa-lose": {
      "pages": [
        "You busted the missed approach point. Go around."
      ]
    },
    "sierra-intro": {
      "pages": [
        "Regulations and emergencies. Show your judgment."
      ]
    },
    "sierra-win": {
      "pages": [
        "Solid judgment under pressure. Onward."
      ]
    },
    "sierra-lose": {
      "pages": [
        "Judgment failed you there. Come back sharper."
      ]
    },
    "tango-intro": {
      "pages": [
        "Weather and planning decide the flight before takeoff."
      ]
    },
    "tango-win": {
      "pages": [
        "You planned around every hazard. Onward."
      ]
    },
    "tango-lose": {
      "pages": [
        "That plan would have flown you into the weather."
      ]
    },
    "uniform-intro": {
      "pages": [
        "Navigate on instruments alone. No excuses."
      ]
    },
    "uniform-win": {
      "pages": [
        "Needles pinned the whole way. Onward."
      ]
    },
    "uniform-lose": {
      "pages": [
        "You lost situational awareness. Reset now."
      ]
    },
    "whiskey-intro": {
      "pages": [
        "Approaches and human limits. The exam's last mile."
      ]
    },
    "whiskey-win": {
      "pages": [
        "You held on to minimums. The circuit is yours."
      ]
    },
    "whiskey-lose": {
      "pages": [
        "Fatigue beat you today. Rest and return."
      ]
    },
    "champion-intro": {
      "pages": [
        "We finish the exam, pilot. Every question counts."
      ]
    },
    "champion-win": {
      "pages": [
        "Congratulations. You are the Region Champion."
      ]
    },
    "champion-lose": {
      "pages": [
        "Close, but the DPE does not round up. Study on."
      ]
    }
  },
